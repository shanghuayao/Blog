---
interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
}

const { href, title, description, pubDate, tags = [] } = Astro.props;
const coverLabel = tags[0] || "Blog";
---

<a class="content-card post-card" href={href}>
  <div class="card-cover">
    <span>{coverLabel}</span>
  </div>
  <div class="card-body">
    <div class="meta-row">
      <span>
        {
          pubDate.toLocaleDateString("zh-CN", {
            year: "numeric",
            month: "2-digit",
            day: "2-digit",
          })
        }
      </span>
      <span>文章</span>
    </div>
    <h3>{title}</h3>
    <p>{description}</p>
    <div class="tags">
      {tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>
  </div>
</a>

---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostCard from "../../../components/PostCard.astro";
import { siteConfig } from "../../../site.config";
import { filterPostsByTaxonomy, getTagSummaries, taxonomyLabel } from "../../../lib/tags";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter((post) => !post.data.draft);
  const parents = getTagSummaries(posts);

  return parents.flatMap((parent) =>
    parent.children.map((child) => ({
      params: { parent: parent.slug, child: child.childSlug },
      props: { parent, child },
    })),
  );
}

const { parent, child } = Astro.props;
const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const taggedPosts = filterPostsByTaxonomy(posts, parent.slug, child.childSlug);
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\//, "")}`;
const label = taxonomyLabel(child);
const title = `${label} | ${siteConfig.defaultTitle}`;
const description = `\u6d4f\u89c8 ${label} \u6807\u7b7e\u4e0b\u7684\u6587\u7ae0\u3002`;
const countText = `${child.count} \u7bc7\u6587\u7ae0`;
---

<BaseLayout title={title} description={description}>
  <section class="container page-head tag-page-head">
    <p class="eyebrow">Tag</p>
    <h1>{label}</h1>
    <p class="lead">{countText}</p>
  </section>
  <section class="section">
    <div class="container blog-grid">
      {
        taggedPosts.map((post) => (
          <PostCard
            href={withBase(`/blog/${post.slug}/`)}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
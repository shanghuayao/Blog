---
import { siteConfig } from "../site.config";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = siteConfig.defaultTitle,
  description = siteConfig.description,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\//, "")}`;
const normalizedPath = Astro.url.pathname.startsWith(base)
  ? `/${Astro.url.pathname.slice(base.length)}`
  : Astro.url.pathname;

const navItems = [
  { href: "/", label: "首页" },
  { href: "/blog/", label: "博客" },
  { href: "/projects/", label: "项目" },
  { href: "/about/", label: "关于" },
];

const categoryItems = [
  { href: "/", label: "最新" },
  { href: "/projects/", label: "项目" },
  { href: "/blog/", label: "写作" },
  { href: "/about/", label: "关于" },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <nav class="topbar" aria-label="主导航">
          <a class="brand" href={withBase("/")}>{siteConfig.brand}</a>
          <div class="nav-links">
            {
              navItems.map((item) => (
                <a
                  href={withBase(item.href)}
                  aria-current={normalizedPath === item.href ? "page" : undefined}
                >
                  {item.label}
                </a>
              ))
            }
            <a class="rss-link" href={withBase("/rss.xml")}>RSS</a>
            <span class="search-pill">搜索</span>
          </div>
        </nav>
      </header>
      <main>
        <div class="category-wrap">
          <nav class="category-nav" aria-label="内容分类">
            {
              categoryItems.map((item, index) => (
                <>
                  <a
                    href={withBase(item.href)}
                    aria-current={normalizedPath === item.href ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                  {index < categoryItems.length - 1 && <span>/</span>}
                </>
              ))
            }
          </nav>
        </div>
        <slot />
      </main>
      <footer class="site-footer">
        <div class="container footer-inner">
          <span>© {new Date().getFullYear()} {siteConfig.name}</span>
          <span>{siteConfig.footerTagline}</span>
        </div>
      </footer>
    </div>
  </body>
</html>

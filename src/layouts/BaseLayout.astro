---
import { siteConfig } from "../site.config";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = siteConfig.defaultTitle,
  description = siteConfig.description,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\//, "")}`;
const normalizedPath = Astro.url.pathname.startsWith(base)
  ? `/${Astro.url.pathname.slice(base.length)}`
  : Astro.url.pathname;


const categoryItems = [
  { href: "/", label: "\u6700\u65b0" },
  { href: "/projects/", label: "\u9879\u76ee" },
  { href: "/blog/", label: "\u5199\u4f5c" },
  { href: "/about/", label: "\u5173\u4e8e" },
];

const isCategoryActive = (href: string) =>
  normalizedPath === href || (href === "/blog/" && normalizedPath.startsWith("/tags/"));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-identity">
        <a class="identity-name" href={withBase("/")}>{siteConfig.name}</a>
        <div class="category-wrap">
          <nav class="category-nav" aria-label="\u5185\u5bb9\u5206\u7c7b">
            {
              categoryItems.map((item, index) => (
                <>
                  <a
                    href={withBase(item.href)}
                    aria-current={isCategoryActive(item.href) ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                  {index < categoryItems.length - 1 && <span>/</span>}
                </>
              ))
            }
          </nav>
        </div>
        <a class="github-link" href={siteConfig.github} target="_blank" rel="noreferrer" aria-label="GitHub">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.52 2.87 8.35 6.84 9.71.5.09.68-.22.68-.49 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.37-3.37-1.37-.45-1.19-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.55-1.14-4.55-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.32 9.32 0 0 1 12 6.97c.85 0 1.7.12 2.5.35 1.9-1.33 2.74-1.05 2.74-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.48-.01 2.82 0 .27.18.59.69.49A10.13 10.13 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z" />
          </svg>
        </a>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <div class="container footer-inner">
          <span>© {new Date().getFullYear()} {siteConfig.name}</span>
          <span>{siteConfig.footerTagline}</span>
        </div>
      </footer>
    </div>
  </body>
</html>

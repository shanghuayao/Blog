---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { siteConfig } from "../../site.config";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\//, "")}`;
const pageDescription = "\u6587\u7ae0\u3001\u7b14\u8bb0\u548c\u9879\u76ee\u590d\u76d8\u3002";
const pageLead = "\u5199\u4e0b\u6280\u672f\u7b14\u8bb0\u3001\u9879\u76ee\u8fc7\u7a0b\u3001\u9605\u8bfb\u6458\u5f55\u548c\u957f\u671f\u89c2\u5bdf\u3002";
---

<BaseLayout title={`\u535a\u5ba2 | ${siteConfig.defaultTitle}`} description={pageDescription}>
  <section class="container page-head">
    <p class="eyebrow">Blog</p>
    <h1>{"\u535a\u5ba2"}</h1>
    <p class="lead">{pageLead}</p>
    <div class="page-actions">
      <a class="text-link" href={withBase("/tags/")}>按标签浏览</a>
    </div>
  </section>
  <section class="section">
    <div class="container blog-grid">
      {
        posts.map((post) => (
          <PostCard
            href={withBase(`/blog/${post.slug}/`)}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>

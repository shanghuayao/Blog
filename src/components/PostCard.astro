---
import { getTaxonomyTags, taxonomyHref, taxonomyLabel } from "../lib/tags";

interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
}

const { href, title, description, pubDate, tags = [] } = Astro.props;
const taxonomyTags = getTaxonomyTags({ title, tags });
const articleLabel = "\u6587\u7ae0";
---

<article class="content-card post-card">
  <div class="card-body">
    <div class="meta-row">
      <span>
        {
          pubDate.toLocaleDateString("zh-CN", {
            year: "numeric",
            month: "2-digit",
            day: "2-digit",
          })
        }
      </span>
      <span>{articleLabel}</span>
    </div>
    <h3><a class="card-title-link" href={href}>{title}</a></h3>
    <p>{description}</p>
    <div class="tags">
      {taxonomyTags.map((tag) => <a class="tag" href={taxonomyHref(tag)}>{taxonomyLabel(tag)}</a>)}
    </div>
  </div>
</article>
